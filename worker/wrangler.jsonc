{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cyber-kanxiang-image-worker-kv",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IMAGE_TASKS",
        "class_name": "ImageTasksDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ImageTasksDO"]
    }
  ],
  "vars": {
    "NEWCLI_BASE_URL": "https://ai.centos.hk/v1"
  }
}
